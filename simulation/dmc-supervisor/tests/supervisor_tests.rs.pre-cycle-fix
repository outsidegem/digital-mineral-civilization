// Functional tests for dmc-supervisor using mock simulator scripts

use std::fs;
use std::path::PathBuf;
use tempfile::tempdir;

use dmc_supervisor::config::Config;
use dmc_supervisor::runner::run_supervisor;

/// Helper to build a Config for tests.
fn make_config(
    sim_bin: &PathBuf,
    out_dir: &PathBuf,
    max_cycles: u32,
    resume: bool,
    min_free: u64,
) -> Config {
    Config {
        suite_mode: "all".to_string(),
        max_cycles,
        simulator_bin: sim_bin.clone(),
        output_dir: out_dir.clone(),
        json_output: false,
        resume,
        min_free_disk_mb: min_free,
        max_mem_mb: 0,
    }
}

#[test]
fn test_successful_cycle() {
    let tmp = tempdir().unwrap();
    let out_dir = tmp.path().join("out");
    let sim = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("mock_sim.sh");
    let cfg = make_config(&sim, &out_dir, 1, false, 0);
    run_supervisor(cfg).expect("Supervisor should succeed");
    // Expect evidence files
    assert!(out_dir.join("cycle_0000.json").exists());
    assert!(out_dir.join("event.log").exists());
    assert!(out_dir.join("checkpoint.json").exists());
}

#[test]
fn test_nonzero_exit_code() {
    let tmp = tempdir().unwrap();
    let out_dir = tmp.path().join("out");
    // Script that exits with code 1
    let script = out_dir.join("fail.sh");
    fs::write(&script, "#!/usr/bin/env sh\nexit 1\n").unwrap();
    std::process::Command::new("chmod")
        .arg("+x")
        .arg(&script)
        .output()
        .unwrap();
    let cfg = make_config(&script, &out_dir, 1, false, 0);
    let res = run_supervisor(cfg);
    assert!(res.is_err(), "Supervisor should error on non‑zero exit");
}

